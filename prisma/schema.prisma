// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TECHNICIAN
  CUSTOMER
}

enum ComplaintStatus {
  Pending
  Assigned
  InProgress
  Completed
}

enum Priority {
  Low
  Medium
  High
}

model User {
  id                String    @id @default(uuid())
  name              String
  username          String    @unique
  phone             String?

  passwordHash      String?
  assignedPassword  String?

  role              Role      @default(CUSTOMER)

  avatar            String?
  fcmToken          String?

  status            String    @default("pending")
  specialty         String?
  experience        Int?      @default(0)
  isAvailable       Boolean   @default(true)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  customerComplaints Complaint[] @relation("CustomerComplaints")
  technicianJobs     Complaint[] @relation("TechnicianJobs")
  addresses          Address[]
  reviews            Review[]    @relation("CustomerReviews")
  techReviews        Review[]    @relation("TechnicianReviews")
  notifications      Notification[]
  acUnits            ACUnit[]
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // Home, Office, Other
  address   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ACUnit {
  id        String @id

  userId    String
  user      User   @relation(fields: [userId], references: [id])

  details   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  complaints Complaint[] @relation("ACUnitComplaints")
}

model Complaint {
  id              String          @id @default(uuid())
  complaintNumber String          @unique // e.g., #CMP-9021
  customerId      String
  customer        User            @relation("CustomerComplaints", fields: [customerId], references: [id])
  technicianId    String?
  technician      User?           @relation("TechnicianJobs", fields: [technicianId], references: [id])
  issueType       String
  description     String
  status          ComplaintStatus @default(Pending)
  priority        Priority        @default(Medium)
  address         Json?
  preferredDate   DateTime?
  images          Json?
  date            DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  acUnits         ACUnit[]        @relation("ACUnitComplaints")
  serviceReport   ServiceReport?
  review          Review?
  events          ComplaintEvent[]
}

model ComplaintEvent {
  id          String    @id @default(uuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  status      String
  description String?
  date        DateTime  @default(now())
}

model ServiceReport {
  id                String    @id @default(uuid())
  complaintId       String    @unique
  complaint         Complaint @relation(fields: [complaintId], references: [id])
  
  // Installation Information
  commissioningDate DateTime
  invoiceNumber     String?
  dop               DateTime?
  engineerName      String

  jobType           String?   // "Installation" or "Service"
  observation       Json?
  actionTaken       Json?
  
  // AC Unit Details
  indoorModel       String?
  indoorSerial      String?
  outdoorModel      String?
  outdoorSerial     String?
  
  // Operation Test (JSON for flexible storage of temps/voltage)
  operationTest     Json?
  
  // Quality Check & Education (JSON)
  qualityCheck      Json?
  customerEducation Json?
  
  // Extra details
  customerName      String?
  mobileNumber      String?
  remarks           String?
  
  // Billing
  installationCharge Float    @default(0)
  gst                Float    @default(0)
  totalAmount        Float    @default(0)
  
  // Files
  customerSignature String?   // File path
  engineerSignature String?   // File path
  images            Json?     // Array of file paths
  pdfPath           String?
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Review {
  id            String    @id @default(uuid())
  complaintId   String    @unique
  complaint     Complaint @relation(fields: [complaintId], references: [id])
  customerId    String
  customer      User      @relation("CustomerReviews", fields: [customerId], references: [id])
  technicianId  String
  technician    User      @relation("TechnicianReviews", fields: [technicianId], references: [id])
  rating        Int
  reviewText    String
  date          DateTime  @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String
  type      String?
  isRead    Boolean  @default(false)
  icon      String?
  color     String?
  createdAt DateTime @default(now())
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  group     String   // company, security, notification, etc.
  updatedAt DateTime @updatedAt
}
